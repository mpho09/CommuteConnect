# Copy to .env for local development. Never commit real secrets (PRD §11.3).

NODE_ENV=development
PORT=4000
# Canonical app URL, used in email links.
APP_BASE_URL=http://localhost:5173
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Supabase (needed from #21/#22). Server only: never expose these to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Integrations (later issues)
RESEND_API_KEY=
MAPS_API_KEY=
