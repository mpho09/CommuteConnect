# Copy to .env for local development. Never commit real secrets (PRD §11.3).

NODE_ENV=development
PORT=4000
# Canonical app URL, used in email links.
APP_BASE_URL=http://localhost:5173
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Supabase. Without these three the API serves only /api/health; all are required
# in production. Server only: never expose these to the browser.
# Project URL, e.g. https://<project-ref>.supabase.co (tokens are checked against its JWKS)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (Project Settings > Database), server only
DATABASE_URL=
# Only if the project still signs tokens with the legacy shared JWT secret (HS256)
SUPABASE_JWT_SECRET=

# Integrations (later issues)
RESEND_API_KEY=
MAPS_API_KEY=
